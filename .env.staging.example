NODE_ENV=production
ADAPTIVE_LEARNING_ENABLED=false
SPEAKING_PRONUNCIATION_ENABLED=false
APP_URL=https://staging.useboost.ru
APP_PORT=3001

# Use unique staging secrets. Never copy production values.
JWT_SECRET=replace-with-a-random-staging-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-separate-staging-database-password
MONITORING_TOKEN=replace-with-a-random-staging-monitoring-token

# Staging must use a separate Telegram bot. Leave empty until it is created.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Prefer separate provider keys with strict budgets.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEAKING_PRONUNCIATION_TIMEOUT_MS=30000
SPEAKING_PRONUNCIATION_MAX_AUDIO_BYTES=10485760
SPEAKING_PRONUNCIATION_MAX_AUDIO_SECONDS=180
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=false
AI_DAILY_REQUEST_BUDGET=50
AI_REQUESTS_PER_HOUR=20
WRITING_REQUESTS_PER_HOUR=10

TTS_REQUESTS_PER_HOUR=100
STT_REQUESTS_PER_HOUR=10
