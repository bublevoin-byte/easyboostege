{
  "name": "easyboost-server",
  "version": "1.0.0",
  "description": "Backend for Easy Boost — English EGE tutor app",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:production": "npm run db:migrate && node server.js",
    "lint": "eslint .",
    "build:frontend": "node scripts/build-frontend.js",
    "prototype:today": "node scripts/serve-today-prototype.js",
    "check": "node scripts/check-syntax.js && node scripts/check-inline-handlers.js",
    "openapi:grammar:sync": "node scripts/sync-grammar-openapi-contract.js",
    "openapi:grammar:check": "node scripts/sync-grammar-openapi-contract.js --check",
    "test": "node --test \"test/*.test.js\"",
    "test:postgres": "node scripts/test-postgres.js",
    "test:e2e": "npm run build:frontend && node e2e/demo.test.js && node e2e/grammar-2-release.test.js && node e2e/vocabulary-library.test.js && node e2e/speaking-task4.test.js && node e2e/speaking-full.test.js && node e2e/speaking-pronunciation-status.test.js && node e2e/aisy-speaking-paper.test.js && node e2e/asya-assistant.test.js && node e2e/aisy-asya-paper.test.js && node e2e/ege-mock-written.test.js && node e2e/ege-mock-oral.test.js && node e2e/ege-mock-result.test.js && node e2e/ege-mock-release.test.js && node e2e/aisy-first-launch.test.js && node e2e/aisy-shell.test.js && node e2e/aisy-today.test.js && node e2e/aisy-accessibility.test.js && node e2e/aisy-learner-release.test.js && node e2e/aisy-writing-paper.test.js && node e2e/aisy-writing-offline-cache.test.js",
    "test:e2e:aisy": "npm run build:frontend && node e2e/aisy-first-launch.test.js && node e2e/aisy-shell.test.js && node e2e/aisy-today.test.js && node e2e/aisy-accessibility.test.js && node e2e/aisy-learner-release.test.js && node e2e/aisy-writing-paper.test.js && node e2e/aisy-writing-offline-cache.test.js && node e2e/aisy-speaking-paper.test.js && node e2e/asya-assistant.test.js && node e2e/aisy-asya-paper.test.js",
    "test:e2e:speaking-paper": "npm run build:frontend && node e2e/aisy-speaking-paper.test.js",
    "test:e2e:asya-paper": "npm run build:frontend && node e2e/asya-assistant.test.js && node e2e/aisy-asya-paper.test.js",
    "test:e2e:writing-paper": "npm run build:frontend && node e2e/aisy-writing-paper.test.js && node e2e/aisy-writing-offline-cache.test.js",
    "test:e2e:ege-mock": "npm run build:frontend && node e2e/aisy-ege-hub.test.js && node e2e/ege-mock-written.test.js && node e2e/ege-mock-oral.test.js && node e2e/ege-mock-result.test.js && node e2e/ege-mock-release.test.js",
    "test:e2e:grammar": "npm run build:frontend && node e2e/grammar-2-release.test.js",
    "test:e2e:speaking-task4": "npm run build:frontend && node e2e/speaking-task4.test.js",
    "test:e2e:speaking-full": "npm run build:frontend && node e2e/speaking-full.test.js",
    "test:e2e:speaking-pronunciation": "npm run build:frontend && node e2e/speaking-pronunciation-status.test.js",
    "test:e2e:vocabulary": "node e2e/vocabulary-library.test.js",
    "test:e2e:adaptive": "npm run build:frontend && node e2e/adaptive-diagnostic.test.js",
    "test:e2e:evidence": "npm run build:frontend && node e2e/reading-listening-evidence.test.js",
    "test:e2e:reading-listening-paper": "npm run build:frontend && node e2e/reading-listening-paper.test.js",
    "test:e2e:reading": "npm run build:frontend && node e2e/reading-2.test.js",
    "test:e2e:progress": "npm run build:frontend && node e2e/learning-progress.test.js",
    "listening:audio:dry-run": "node scripts/listening-static-audio.js",
    "listening:audio:generate": "node scripts/listening-static-audio.js --paid",
    "test:e2e:firefox": "cross-env E2E_BROWSER=firefox node e2e/demo.test.js",
    "test:e2e:android": "cross-env E2E_BROWSER=chromium E2E_PROFILE=android node e2e/demo.test.js",
    "test:e2e:iphone-webkit": "cross-env E2E_BROWSER=webkit E2E_PROFILE=iphone node e2e/demo.test.js",
    "test:e2e:performance": "node e2e/performance.test.js",
    "test:telegram:staging": "node scripts/telegram-staging-e2e.js",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/scan-secrets.js",
    "security:history": "node scripts/scan-secret-history.js",
    "quality:sources": "node scripts/fetch-quality-sources.js",
    "quality:extract": "node scripts/extract-quality-speaking.js && node scripts/extract-quality-speaking-reviewed.js",
    "quality:extract:reviewed": "node scripts/extract-quality-speaking-reviewed.js",
    "quality:stubs": "node scripts/extract-quality-writing.js",
    "quality:assignments": "node scripts/build-quality-assignments.js",
    "quality:worksheet": "node scripts/build-transcription-worksheet.js",
    "quality:merge": "node scripts/merge-transcription-worksheet.js",
    "quality:charts": "node scripts/build-pie-chart-worksheet.js",
    "quality:merge-charts": "node scripts/merge-pie-charts.js",
    "quality:run": "node scripts/ai-quality-run.js",
    "quality:merge-runs": "node scripts/merge-quality-runs.js",
    "quality:worksheet-review": "node scripts/build-review-worksheet.js",
    "quality:merge-review": "node scripts/merge-review-worksheet.js",
    "quality:check": "node scripts/ai-quality-report.js",
    "quality:release": "node scripts/ai-quality-report.js --release",
    "quality:speaking-calibration": "node scripts/speaking-calibration-report.js",
    "monitor": "node scripts/monitor.js",
    "load:smoke": "node scripts/load-smoke.js",
    "tz:readiness": "node scripts/tz-readiness.js",
    "soak:check": "node scripts/staging-soak-check.js",
    "db:migrate": "node scripts/migrate.js",
    "db:import-json": "node scripts/import-json.js",
    "db:backup": "node scripts/postgres-backup.js",
    "db:restore": "node scripts/postgres-restore.js",
    "db:verify-backup": "node scripts/postgres-verify-backup.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "msedge-tts": "^2.0.7",
    "pg": "^8.22.0",
    "ws": "8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "playwright": "^1.62.0",
    "vite": "^8.1.5"
  }
}
