# Скопируй этот файл в .env и заполни значения ТАМ (в .env, не в .env.example).
PORT=3000
NODE_ENV=development
JWT_SECRET=zamenи-na-dlinnuyu-sluchaynuyu-stroku-1234567890
SESSION_DAYS=30

# Adaptive EGE plan is unreleased and fails closed until explicitly enabled.
ADAPTIVE_LEARNING_ENABLED=false

# --- Optional Azure Speech pronunciation assessment (server-side only) ---
# Keep disabled until the owner has installed the official SDK and completed the paid manual smoke gate.
SPEAKING_PRONUNCIATION_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SPEAKING_PRONUNCIATION_TIMEOUT_MS=30000
SPEAKING_PRONUNCIATION_MAX_AUDIO_BYTES=10485760
SPEAKING_PRONUNCIATION_MAX_AUDIO_SECONDS=180

# --- Voice Tutor Premium: лимиты задаются в секундах и не отправляются клиенту целиком ---
VOICE_TUTOR_DAILY_SECONDS=600
VOICE_TUTOR_MONTHLY_SECONDS=7200
VOICE_TUTOR_SESSION_SECONDS=300
VOICE_TUTOR_SESSION_STARTS_PER_HOUR=30
VOICE_TUTOR_ENABLED=false
VOICE_TUTOR_COST_KILL_SWITCH=false
VOICE_TUTOR_COST_MICROUSD_PER_MINUTE=50000
VOICE_TUTOR_REQUIRE_ZDR=false
XAI_VOICE_ZDR_ATTESTED=false
# Production принимает только immutable grok-voice semver/date revision (например, grok-voice-think-fast-1.0); blank/latest/current/stable/preview/alias/unversioned fail closed до provider call.
XAI_VOICE_MODEL=
# Lowercase built-in voice id (for example ara/eve) or lowercase custom voice id.
XAI_VOICE_NAME=
VOICE_TUTOR_PROXY_TICKET_TTL_SECONDS=30
XAI_VOICE_HANDSHAKE_TIMEOUT_MS=10000
# XAI_VOICE_REALTIME_URL=wss://api.x.ai/v1/realtime
# Server-only trusted rule discovery. Keep at least two independent authorities per skill.
# VOICE_TUTOR_RULE_ALLOWLIST_JSON=[{"authority":"cambridge","domain":"dictionary.cambridge.org","pathPrefixes":["/grammar/"]},{"authority":"british-council","domain":"learnenglish.britishcouncil.org","pathPrefixes":["/grammar/"]}]
# VOICE_TUTOR_RULE_SOURCES_JSON={"ege.grammar.future_passive":["https://dictionary.cambridge.org/grammar/british-grammar/passive-forms","https://learnenglish.britishcouncil.org/grammar/b1-b2-grammar/passives"]}
# Production search uses xAI Responses web_search and accepts citation URLs only from the allowlist (2-5 domains).
VOICE_TUTOR_RULE_SEARCH_ENABLED=false
# XAI_RULE_SEARCH_URL=https://api.x.ai/v1/responses
# XAI_RULE_SEARCH_MODEL=grok-4.5
XAI_RULE_SEARCH_TIMEOUT_MS=15000

# development: file; production: postgres
DATABASE_PROVIDER=file
DATA_FILE=./data.json
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://easyboost:password@localhost:5432/easyboost

# --- Вход через Telegram ---
# Токен бота из @BotFather (вид: 123456789:AA...). Без него вход через Telegram выключен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_CODE_TTL_MS=600000
TELEGRAM_AUTH_STARTS_PER_15_MINUTES=10
TELEGRAM_AUTH_CHECKS_PER_15_MINUTES=300

# Твой личный Telegram ID (владельца) — тебе будут приходить заявки на оплату с кнопками
# Активировать/Отказ. Узнать свой ID: напиши боту команду /id (он ответит числом).
ADMIN_TELEGRAM_ID=

# Адрес приложения — для ссылки входа, которую бот присылает после Start.
APP_URL=https://useboost.ru

# --- Версия API (раздел 13.1) ---
# Все маршруты живут под /api/v1/. Пока переменная равна true, сервер принимает и
# старые пути без версии, переписывает их и пишет в лог предупреждение api_legacy_path.
# Это нужно ровно для одного случая: устройство с закэшированной старой сборкой PWA
# продолжает работать сразу после деплоя. Когда предупреждения перестанут появляться —
# поставь false, иначе версия в адресе теряет смысл.
API_ACCEPT_LEGACY_PATHS=true

# Случайная строка не короче 32 символов для локального host-monitor.
MONITORING_TOKEN=

# --- ИИ: основной провайдер — Grok (xAI, платный) ---
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_ENABLED=true
# XAI_API_URL=https://api.x.ai/v1/chat/completions

# --- ИИ: резерв — Groq (бесплатный) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=true
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# --- Ограничения и таймауты ИИ ---
AI_TIMEOUT_MS=25000
AI_REQUESTS_PER_HOUR=60
WRITING_REQUESTS_PER_HOUR=30
TTS_REQUESTS_PER_HOUR=300
STT_REQUESTS_PER_HOUR=30
STT_TIMEOUT_MS=30000
STT_MAX_BYTES=20971520
TTS_TIMEOUT_MS=20000
TTS_MAX_BYTES=5242880
TTS_CACHE_MAX_AGE_MS=604800000
TTS_CACHE_MAX_BYTES=268435456
AI_DAILY_REQUEST_BUDGET=1000
AI_DICTIONARY_CACHE_TTL_MS=86400000
# Стоимость в миллионных долях USD за 1 млн токенов; заполни после выбора моделей.
XAI_INPUT_MICROUSD_PER_MILLION=0
XAI_OUTPUT_MICROUSD_PER_MILLION=0
GROQ_INPUT_MICROUSD_PER_MILLION=0
GROQ_OUTPUT_MICROUSD_PER_MILLION=0

# Только для compose.production.yml. Используй отдельный длинный пароль.
POSTGRES_PASSWORD=change-me-before-production
APP_PORT=3000
